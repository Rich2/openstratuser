//| mill-jvm-version: 25
import mill.*, scalalib.*, scalajslib.*, coursier._, mill.maven.MavenRepository//mill.define.ModuleRef

object User extends ScalaModule {
  def scalaVersion = "3.9.0"
  val rStrat = Repository("https://richstrat.com/repository")
  def repositoriesTask = Task.Anon {
    super.repositoriesTask() :+ rStrat
  }
  def ivyDeps = Agg(
    ivy"com.richstrat::rutil:0.4.0",
    ivy"com.richstrat::geom:0.4.0"
  )
}